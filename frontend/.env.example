# Backend API (must be https and publicly reachable for device builds)
NEXT_PUBLIC_API_URL=http://localhost:8000

# RevenueCat PUBLIC SDK keys (safe to ship in the app). Dashboard -> Project -> API keys.
# For development on a device use a Test Store key; for release use the platform store keys.
NEXT_PUBLIC_REVENUECAT_API_KEY_ANDROID=
NEXT_PUBLIC_REVENUECAT_API_KEY_IOS=
# Entitlement identifier configured in RevenueCat (must match backend REVENUECAT_ENTITLEMENT_ID)
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# Optional: RevenueCat offering identifier. Empty = the dashboard's "current" offering.
NEXT_PUBLIC_REVENUECAT_OFFERING_ID=

# Legal pages shown on the paywall. Defaults to the in-app draft pages.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
