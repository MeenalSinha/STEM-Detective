# ── Required ────────────────────────────────────────────────────────────────
# Postgres 15+ with the pgvector extension
DATABASE_URL=postgresql://postgres:password@localhost:5432/stemdetective
# Random string, 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development            # "production" disables /docs and enforces a strong SECRET_KEY
# Include your deployed web origin if any. Capacitor origins are included by default.
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost,http://localhost

# ── AI (optional: The Silent Greenhouse is fully playable without these) ────
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_DEMO_MODE=false                 # true returns canned demo AI output; keep false in production

# ── RevenueCat (server side) ────────────────────────────────────────────────
# SECRET API key (sk_...). Dashboard -> Project settings -> API keys. NEVER ship this in the app.
REVENUECAT_SECRET_API_KEY=
# Must equal the Authorization header value you configure on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=pro
ENTITLEMENT_CACHE_SECONDS=300
ENTITLEMENT_OFFLINE_GRACE_SECONDS=86400

# ── Free tier limits ────────────────────────────────────────────────────────
FREE_HINTS_PER_CASE=3
FREE_AI_CASES=2

# ── Legacy / unused by the flagship ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
REDIS_URL=redis://localhost:6379
